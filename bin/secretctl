#!/usr/bin/env bash
# secretctl v0.2 — sops+age 加密密钥库管理包装器
# 布局（~/.config/secret-store/，全部 0600）：
#   secrets.enc.yaml  仅秘密值（sops+age 密文）+ 哨兵键
#   metadata.tsv      明文元数据边车：KEY/系统/账号/到期/录入/来源/备注
#   challenge.json    密保问题（scrypt 哈希，可选启用）
#   .challenge-pass   密保通过时间戳（宽限窗口内免重答）
#   audit.log         append-only 审计日志（无秘密值）
# 原则：秘密值永不作为命令行参数；明文临时文件登记并 shred；list/盘点不解密；
#       use 走 sops exec-env 注入；加密显式 --age；调取类命令受密保门槛约束。
set -euo pipefail
umask 077

STORE_DIR="${SECRETCTL_DIR:-$HOME/.config/secret-store}"
STORE="$STORE_DIR/secrets.enc.yaml"
META="$STORE_DIR/metadata.tsv"
AUDIT="$STORE_DIR/audit.log"
CHAL="$STORE_DIR/challenge.json"
PASSF="$STORE_DIR/.challenge-pass"
KEYFILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"
PASS_TTL="${SECRETCTL_PASS_TTL:-300}"                  # 密保通过后的宽限秒数
MAX_FAILS="${SECRETCTL_MAX_FAILS:-5}"                  # 连续失败锁定阈值
LOCK_SECS="${SECRETCTL_LOCK_SECS:-1800}"               # 锁定时长

die()  { echo "secretctl: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "缺少依赖: $1（期望在 PATH，如 ~/.local/bin）"; }

TMPS=(); _TMP=""
newtmp() { _TMP=$(mktemp "$STORE_DIR/.tmp.XXXXXX.yaml"); TMPS+=("$_TMP"); }
cleanup() {
  local t
  for t in ${TMPS[@]+"${TMPS[@]}"}; do
    if [ -e "$t" ]; then shred -u "$t" 2>/dev/null || rm -f "$t" || true; fi
  done
  return 0
}
trap cleanup EXIT

audit() { # action key result source
  mkdir -p "$STORE_DIR"
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date -Iseconds)" "${1:-?}" "${2:--}" "${3:-ok}" "${4:-cli}" >> "$AUDIT"
  chmod 600 "$AUDIT" 2>/dev/null || true
}

pubkey() {
  local pk; pk=$(grep -oE 'age1[0-9a-z]+' "$KEYFILE" | head -1)
  [ -n "$pk" ] || die "无法从 $KEYFILE 读取 age 公钥"
  echo "$pk"
}
ensure_store() { [ -s "$STORE" ] || die "密钥库不存在或为空，先运行: secretctl init"; }

# ---- 密保状态机（python3 内嵌：scrypt 哈希 + 失败计数 + 锁定 + 宽限窗口） ----
# 注意：程序经 -c 传递而非 `python3 - <<EOF`——后者会用 stdin 传程序，
# 程序内 sys.stdin 即告枯竭，Q/A、答案等管道输入将永远读不到。
_PY_PROG=""
read -r -d '' _PY_PROG <<'PYEOF' || true
import sys, os, json, time, hashlib, secrets

chal_f  = os.environ["CHAL_FILE"]; pass_f = os.environ["PASS_FILE"]
ttl     = int(os.environ["PASS_TTL"]); max_fails = int(os.environ["MAX_FAILS"])
lock_s  = int(os.environ["LOCK_SECS"])
op      = sys.argv[1]

def kdf(ans: str, salt: bytes) -> str:
    return hashlib.scrypt(ans.encode(), salt=salt, n=16384, r=8, p=1, dklen=32).hex()

def load():
    with open(chal_f) as f: return json.load(f)

def save(d):
    tmp = chal_f + ".tmp"
    with open(tmp, "w") as f: json.dump(d, f, ensure_ascii=False, indent=1)
    os.chmod(tmp, 0o600); os.replace(tmp, chal_f)

if op == "init":
    lines = [l.rstrip("\n") for l in sys.stdin]
    pairs = [(lines[i], lines[i+1]) for i in range(0, len(lines)-1, 2)]
    if not (1 <= len(pairs) <= 5): print("BAD_PAIRS"); sys.exit(1)
    qs = []
    for q, a in pairs:
        if not q.strip() or not a.strip(): print("BAD_PAIRS"); sys.exit(1)
        s = secrets.token_bytes(16)
        qs.append({"q": q.strip(), "salt": s.hex(), "hash": kdf(a, s)})
    save({"version": 1, "grace_sec": ttl, "fails": 0, "lock_until": 0, "questions": qs})
    print("OK:%d" % len(qs))
elif op == "questions":
    for e in load()["questions"]: print(e["q"])
elif op == "verify-all":
    d = load(); now = time.time()
    if d["lock_until"] > now:
        print("LOCKED:%d" % int(d["lock_until"] - now)); sys.exit(0)
    answers = [l.rstrip("\n") for l in sys.stdin]
    ok = len(answers) == len(d["questions"]) and all(
        kdf(a, bytes.fromhex(e["salt"])) == e["hash"] for a, e in zip(answers, d["questions"]))
    if ok:
        d["fails"] = 0; d["lock_until"] = 0; save(d)
        with open(pass_f, "w") as f: f.write(str(int(now)))
        os.chmod(pass_f, 0o600)
        print("PASS")
    else:
        d["fails"] += 1
        if d["fails"] >= max_fails:
            d["lock_until"] = now + lock_s; d["fails"] = 0; save(d)
            print("LOCKED:%d" % lock_s)
        else:
            save(d); print("FAIL:%d" % (max_fails - d["fails"]))
elif op == "check-pass":
    if not os.path.exists(chal_f): print("DISABLED"); sys.exit(0)
    d = load(); now = time.time()
    if d["lock_until"] > now: print("LOCKED:%d" % int(d["lock_until"] - now)); sys.exit(0)
    try:
        ts = int(open(pass_f).read().strip())
    except Exception:
        print("MISSING"); sys.exit(0)
    grace = d.get("grace_sec", ttl)
    print("OK" if now - ts <= grace else "EXPIRED")
else:
    print("BAD_OP"); sys.exit(2)
PYEOF
_py() {
  CHAL_FILE="$CHAL" PASS_FILE="$PASSF" PASS_TTL="$PASS_TTL" \
  MAX_FAILS="$MAX_FAILS" LOCK_SECS="$LOCK_SECS" python3 -c "$_PY_PROG" "$@"
}

require_pass() { # 调取类命令（get/use/peek）的密保门槛
  [ -f "$CHAL" ] || return 0
  local st; st=$(_py check-pass)
  case "$st" in
    OK|DISABLED) return 0;;
    LOCKED:*)  audit challenge "" locked cli; die "密保已锁定（剩余 ${st#LOCKED:} 秒），稍后再试";;
    *)         die "需先通过密保验证（状态:$st）：终端运行 secretctl challenge，或让 agent 按 secret-store skill 流程编排";;
  esac
}

cmd_init() {
  need age-keygen; need sops
  mkdir -p "$STORE_DIR" "$(dirname "$KEYFILE")"
  if [ ! -f "$KEYFILE" ]; then
    age-keygen -o "$KEYFILE" 2>/dev/null
    chmod 600 "$KEYFILE"
    echo "已生成 age 主密钥: $KEYFILE"
    echo "!! 请立即执行 secretctl backup-key 查看离线备份指引（丢了全库不可解）"
  fi
  local pk; pk=$(pubkey)
  cat > "$STORE_DIR/.sops.yaml" <<EOF
creation_rules:
  - path_regex: .*
    age: "$pk"
EOF
  chmod 600 "$STORE_DIR/.sops.yaml"
  if [ ! -s "$STORE" ]; then
    rm -f "$STORE"
    newtmp; local seed="$_TMP"
    {
      echo "# dsh secret store — 值由 sops+age 加密；元数据见 metadata.tsv"
      echo "_STORE_VERSION: '1'"
    } > "$seed"
    sops --encrypt --age "$pk" "$seed" > "$STORE"
    chmod 600 "$STORE"
  fi
  [ -f "$META" ] || { : > "$META"; chmod 600 "$META"; }
  [ -f "$AUDIT" ] || { : > "$AUDIT"; chmod 600 "$AUDIT"; }
  audit init "" ok cli
  echo "密钥库就绪: $STORE"
}

cmd_backup_key() {
  echo "主密钥文件: $KEYFILE (应为 0600)"
  echo "备份方式（建议两种，异地保存）:"
  echo "  1) 在你自己的终端执行并手抄私钥行:  grep SECRET-KEY $KEYFILE"
  echo "  2) 将文件复制到加密U盘或密码管理器附件"
  echo "恢复: 放回原路径并 chmod 600，全库即可解密"
}

meta_upsert() { # KEY system account expires source note
  local key="$1" system="$2" account="$3" expires="$4" source="$5" note="$6"
  newtmp; local mtmp="$_TMP"
  if [ -f "$META" ]; then awk -F'\t' -v k="$key" '$1!=k' "$META" > "$mtmp"; else : > "$mtmp"; fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$key" "$system" "$account" "${expires:-长期}" "$(date -Iseconds)" "$source" "$note" >> "$mtmp"
  mv -f "$mtmp" "$META"; chmod 600 "$META"
}

# 公共登记内核：值经函数参数传递（绝不进 argv）
_store_value() { # KEY value
  local key="$1" value="$2" pk
  pk=$(pubkey)
  newtmp; local plain="$_TMP"
  newtmp; local out="$_TMP"
  sops --decrypt "$STORE" > "$plain"
  grep -v "^$key:" "$plain" > "$out" || true
  printf "%s: '%s'\n" "$key" "${value//\'/\'\'}" >> "$out"
  sops --encrypt --age "$pk" "$out" > "$STORE.reenc"
  mv -f "$STORE.reenc" "$STORE"; chmod 600 "$STORE"
}

_mask() { V="$1" python3 -c '
import os; v=os.environ["V"]
print((v[:3]+"****"+v[-4:]) if len(v)>8 else "****(len=%d)"%len(v))'; }

# add KEY [--system S] [--account A] [--expires D] [--note N] [--source S]
#         [--from-file F | --stdin | tty 交互]
cmd_add() {
  ensure_store; need sops
  local key="${1:-}"; [ -n "$key" ] || die "用法: secretctl add KEY [选项]（值绝不走命令行参数）"
  echo "$key" | grep -qE '^[A-Za-z_][A-Za-z0-9_]*$' || die "KEY 需为环境变量风格（字母/数字/下划线）"
  [ "$key" = "_STORE_VERSION" ] && die "保留键名"
  shift
  local system="未填" account="" expires="" note="" source="cli" from_file="" use_stdin=0
  while [ $# -gt 0 ]; do case "$1" in
    --system)    system="${2:-}"; shift 2;;
    --account)   account="${2:-}"; shift 2;;
    --expires)   expires="${2:-}"; shift 2;;
    --note)      note="${2:-}"; shift 2;;
    --source)    source="${2:-}"; shift 2;;
    --from-file) from_file="${2:-}"; shift 2;;
    --stdin)     use_stdin=1; shift;;
    *) die "未知参数: $1";;
  esac; done

  local value
  if [ -n "$from_file" ]; then
    [ -f "$from_file" ] || die "文件不存在: $from_file"
    value=$(cat "$from_file"); shred -u "$from_file" 2>/dev/null || rm -f "$from_file"
  elif [ "$use_stdin" = 1 ]; then
    value=$(cat)
  elif [ -t 0 ]; then
    printf '输入秘密值（不回显）: ' >&2
    IFS= read -rs value; printf '\n' >&2
  else
    die "非交互环境请用 --stdin 或 --from-file"
  fi
  [ -n "$value" ] || die "空值拒绝入库"
  case "$value" in *$'\n'*) die "暂不支持多行值（证书/私钥请先 base64 -w0 单行化）";; esac

  _store_value "$key" "$value"
  value=""
  meta_upsert "$key" "$system" "$account" "$expires" "$source" "$note"
  audit add "$key" ok "$source"
  echo "已登记: $key  system=$system  expires=${expires:-长期}"
}

# gen KEY [--system S] [--account A] [--expires D] [--note N] [--len N] [--no-symbols]
# 本地生成强密钥直接入库：明文不出现在聊天/终端/日志，任何出口只见脱敏值
cmd_gen() {
  ensure_store; need sops
  local key="${1:-}"; [ -n "$key" ] || die "用法: secretctl gen KEY [--system S] [--len 24] [--no-symbols]"
  echo "$key" | grep -qE '^[A-Za-z_][A-Za-z0-9_]*$' || die "KEY 需为环境变量风格"
  [ "$key" = "_STORE_VERSION" ] && die "保留键名"
  shift
  local system="未填" account="" expires="" note="" len=24 symbols=1 source="generated"
  while [ $# -gt 0 ]; do case "$1" in
    --system)     system="${2:-}"; shift 2;;
    --account)    account="${2:-}"; shift 2;;
    --expires)    expires="${2:-}"; shift 2;;
    --note)       note="${2:-}"; shift 2;;
    --len)        len="${2:-24}"; shift 2;;
    --no-symbols) symbols=0; shift;;
    *) die "未知参数: $1";;
  esac; done
  [ "$len" -ge 12 ] 2>/dev/null || die "--len 至少 12"

  local value masked
  value=$(SYM=$symbols LEN=$len python3 -c '
import os, secrets, string
alpha = string.ascii_letters + string.digits
if os.environ["SYM"] == "1": alpha += "!#%*+,-._?"
print("".join(secrets.choice(alpha) for _ in range(int(os.environ["LEN"]))))')
  _store_value "$key" "$value"
  masked=$(_mask "$value")
  value=""
  meta_upsert "$key" "$system" "$account" "$expires" "$source" "本地生成,${len}位"
  audit gen "$key" ok "$source"
  echo "已生成并入库: $key  脱敏=${masked}  system=$system  expires=${expires:-长期}"
  echo "（明文从未显示；使用走 secretctl use 注入，人工查看走 secretctl get）"
}

cmd_list() {
  ensure_store
  echo "密钥库: $STORE"
  [ -f "$CHAL" ] && echo "密保保护: 已启用（调取需 challenge 通过，宽限 ${PASS_TTL}s）"
  echo "------------------------------------------------------------------------------"
  if [ -s "$META" ]; then
    awk -F'\t' '
      BEGIN{printf "%-18s %-12s %-16s %-11s %-11s %-6s %s\n","KEY","系统","账号","到期","录入","来源","备注"}
      {printf "%-18s %-12s %-16s %-11s %-11s %-6s %s\n",$1,$2,$3,$4,substr($5,1,10),$6,$7}
    ' "$META"
  else
    echo "（暂无登记条目）"
  fi
  local k
  for k in $(grep -oE '^[A-Za-z_][A-Za-z0-9_]*:' "$STORE" | tr -d ':' | grep -v -e '^_STORE_VERSION$' -e '^sops$' || true); do
    if [ ! -s "$META" ] || ! awk -F'\t' -v k="$k" '$1==k{f=1}END{exit !f}' "$META"; then
      echo "$k  [加密·元数据缺失]"
    fi
  done
}

# peek KEY —— 脱敏出口：只显示前3后4（短值只显示长度），审计留痕
cmd_peek() {
  ensure_store; need sops; require_pass
  local key="${1:-}"; [ -n "$key" ] || die "用法: secretctl peek KEY"
  local v; v=$(sops --decrypt --extract "[\"$key\"]" "$STORE")
  _mask "$v"; v=""
  audit peek "$key" ok cli
}

cmd_get() {
  ensure_store; need sops; require_pass
  local key="${1:-}"; [ -n "$key" ] || die "用法: secretctl get KEY   # 警告: 明文打印到 stdout"
  local v; v=$(sops --decrypt --extract "[\"$key\"]" "$STORE")
  audit get "$key" ok cli
  printf '%s\n' "$v"
}

# use -- 'CMD...'  全部键注入子进程环境变量，明文不进 stdout
cmd_use() {
  ensure_store; need sops; require_pass
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "用法: secretctl use -- 'curl -H \"Authorization: \$GITHUB_TOKEN\" https://...'"
  audit use "-" ok "cmd:$1"
  sops exec-env "$STORE" "$*"
}

cmd_rm() {
  ensure_store; need sops
  local key="${1:-}"; [ -n "$key" ] || die "用法: secretctl rm KEY"
  local pk; pk=$(pubkey)
  newtmp; local plain="$_TMP"
  newtmp; local out="$_TMP"
  sops --decrypt "$STORE" > "$plain"
  grep -v "^$key:" "$plain" > "$out" || true
  sops --encrypt --age "$pk" "$out" > "$STORE.reenc"
  mv -f "$STORE.reenc" "$STORE"; chmod 600 "$STORE"
  if [ -f "$META" ]; then
    newtmp; local mtmp="$_TMP"
    awk -F'\t' -v k="$key" '$1!=k' "$META" > "$mtmp"
    mv -f "$mtmp" "$META"; chmod 600 "$META"
  fi
  audit rm "$key" ok cli
  echo "已删除: $key"
}

# expiry [DAYS] —— 到期巡检（默认 30 天窗口），只读元数据不解密
# 注意：必须用 awk -F'\t' 解析（空账号列会产生连续 tab；IFS=$'\t' read 会合并它们导致串列）
cmd_expiry() {
  ensure_store
  local days="${1:-30}"
  awk -F'\t' -v now="$(date +%s)" -v days="$days" '
    $4 != "" && $4 != "长期" {
      split($4, d, "-")
      to = mktime(d[1] " " d[2] " " d[3] " 0 0 0")
      left = int((to - now) / 86400)
      if (left <= days) {
        found = 1
        if (left < 0) printf "%-18s %-12s 已过期 %d 天（%s）\n", $1, $2, -left, $4
        else          printf "%-18s %-12s 剩余 %d 天（%s）\n", $1, $2, left, $4
      }
    }
    END { if (!found) print "未来 " days " 天内无到期条目。" }
  ' "$META"
  audit expiry "-" ok "days:$days"
}

cmd_audit_show() {
  [ -f "$AUDIT" ] || die "暂无审计日志"
  local n="${1:-20}"
  echo "时间                 动作         KEY               结果     来源"
  tail -n "$n" "$AUDIT" | awk -F'\t' '{printf "%-20s %-12s %-17s %-8s %s\n",substr($1,1,19),$2,$3,$4,$5}'
}

# ---- 密保管理 ----
cmd_protect() {
  local sub="${1:-status}"; shift || true
  case "$sub" in
    init)
      mkdir -p "$STORE_DIR"
      if [ -f "$CHAL" ]; then die "密保已设置；先 secretctl protect off 再重设"; fi
      local rc
      if [ "${1:-}" = "--stdin" ]; then
        rc=$(_py init) || die "stdin 需按 Q/A 交替行输入（1-5 组，行内勿留空）"
      elif [ -t 0 ]; then
        local lines=() q a n=1
        while :; do
          printf '问题 %d（空行结束，至少 1 题，最多 5 题）: ' "$n" >&2
          IFS= read -r q || break
          [ -z "$q" ] && break
          printf '答案 %d（不回显）: ' "$n" >&2
          IFS= read -rs a || break; printf '\n' >&2
          if [ -z "$a" ]; then die "答案不能为空"; fi
          lines+=("$q" "$a"); n=$((n+1))
          if [ "$n" -gt 5 ]; then break; fi
        done
        if [ $((${#lines[@]} / 2)) -lt 1 ]; then die "至少设置 1 个问题"; fi
        rc=$(printf '%s\n' "${lines[@]}" | _py init) || die "设置失败"
        lines=()
      else
        die "非交互环境请用: secretctl protect init --stdin（Q/A 交替行）"
      fi
      [ "$rc" = "OK:1" ] || [ "${rc#OK:}" -ge 1 ] 2>/dev/null || die "设置失败: $rc"
      chmod 600 "$CHAL" 2>/dev/null || true
      audit protect-init "-" ok cli
      echo "密保已启用（${rc#OK:} 题，宽限 ${PASS_TTL}s）。get/use/peek 需先通过 secretctl challenge。"
      ;;
    questions)
      [ -f "$CHAL" ] || die "未启用密保"
      _py questions
      ;;
    status)
      if [ -f "$CHAL" ]; then
        echo "密保: 已启用（$(_py questions | wc -l) 题）；当前状态: $(_py check-pass)"
      else
        echo "密保: 未启用（get/use/peek 无门槛）"
      fi
      ;;
    off)
      [ -f "$CHAL" ] || die "未启用密保"
      rm -f "$CHAL" "$PASSF"
      audit protect-off "-" ok cli
      echo "密保已关闭。"
      ;;
    *) die "用法: secretctl protect {init [--stdin] | questions | status | off}";;
  esac
}

cmd_challenge() {
  [ -f "$CHAL" ] || die "未启用密保（secretctl protect init 先设置）"
  local answers=() res
  if [ "${1:-}" = "--stdin" ]; then
    local l
    while IFS= read -r l; do answers+=("$l"); done
  elif [ -t 0 ]; then
    local i=1 q a
    while IFS= read -r q; do
      printf '[%d] %s\n答（不回显）: ' "$i" "$q" >&2
      IFS= read -rs a; printf '\n' >&2
      answers+=("$a"); i=$((i+1))
    done < <(_py questions)
  else
    die "非交互环境请用: printf '%s\\n' '答1' '答2' | secretctl challenge --stdin"
  fi
  res=$(printf '%s\n' ${answers[@]+"${answers[@]}"} | _py verify-all)
  answers=()
  case "$res" in
    PASS)     audit challenge "-" pass cli; echo "密保通过 ✅ 宽限窗口内可执行 get/use/peek（窗口长度以 protect init 时配置为准，默认 300s）";;
    FAIL:*)   audit challenge "-" fail cli; die "答案错误，剩余尝试次数: ${res#FAIL:}";;
    LOCKED:*) audit challenge "-" locked cli; die "失败次数过多，已锁定 ${res#LOCKED:} 秒";;
    *)        die "验证异常: $res";;
  esac
}

cmd_edit() { ensure_store; need sops; EDITOR="${EDITOR:-vi}" sops "$STORE"; }
cmd_path() { echo "$STORE"; }

case "${1:-help}" in
  init)       shift; cmd_init "$@";;
  add)        shift; cmd_add "$@";;
  gen)        shift; cmd_gen "$@";;
  list|ls)    shift; cmd_list;;
  peek)       shift; cmd_peek "$@";;
  get|show)   shift; cmd_get "$@";;
  use|exec)   shift; cmd_use "$@";;
  rm|remove)  shift; cmd_rm "$@";;
  expiry)     shift; cmd_expiry "$@";;
  audit)      shift; cmd_audit_show "$@";;
  protect)    shift; cmd_protect "$@";;
  challenge)  shift; cmd_challenge "$@";;
  edit)       shift; cmd_edit;;
  path)       shift; cmd_path;;
  backup-key) shift; cmd_backup_key;;
  help|*)
    cat <<'EOF'
secretctl v0.2 — sops+age 加密密钥库（密保/审计/生成/脱敏/到期）
  init                     初始化（幂等）
  add KEY [--system S] [--account A] [--expires D] [--note N] [--source S]
          [--from-file F | --stdin | tty 交互]     登记（值不走命令行）
  gen KEY [--system S] [--len 24] [--no-symbols]   本地生成强密钥直接入库（明文永不显示）
  list                     元数据盘点（不解密）
  expiry [DAYS]            到期巡检（默认 30 天窗口）
  peek KEY                 脱敏查看（前3后4）
  get KEY                  明文打印（人工用；受密保门槛）
  use -- 'CMD'             键注入环境变量后执行（受密保门槛；明文不落 stdout）
  rm KEY / edit / path
  protect init|questions|status|off                密保问题管理（scrypt 哈希）
  challenge [--stdin]      回答密保（通过后宽限 300s；5 次失败锁定 30 分钟）
  audit [N]                审计日志末 N 行（默认 20）
  backup-key               主密钥离线备份指引
文件: ~/.config/secret-store/{secrets.enc.yaml, metadata.tsv, challenge.json, audit.log}
主密钥: ~/.config/sops/age/keys.txt（0600，务必离线备份！）
EOF
    ;;
esac
